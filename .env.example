APP_NAME="Perlcon International"
APP_ENV=production
APP_KEY=base64:BI8Ka/lxB526Gtuo3PhEOSh5so9+UFkynQzHZhWKU94=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =======================================================
# DATABASE CONFIGURATION FOR CPANEL / HOSTING SERVER:
# When uploading to server, set your MySQL credentials here.
# Then hit route: https://your-domain.com/setup-db
# or https://your-domain.com/setup-db/quick
# =======================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_database
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

# For local development with SQLite fallback:
# DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
